; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GetLevelOfAMonkey"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.5")

[autoload]

ConfigLoader="*res://autoload/config_loader.gd"
GameBootstrap="*res://autoload/game_bootstrap.gd"
GameState="*res://autoload/game_state.gd"
I18n="*res://autoload/i18n.gd"
SaveManager="*res://autoload/save_manager.gd"
ProgressionSystem="*res://autoload/progression_system.gd"
InputManager="*res://autoload/input_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
SceneManager="*res://autoload/scene_manager.gd"
BrainLinkBridge="*res://autoload/brainlink_bridge.gd"
GameUI="*res://scenes/ui/game_ui.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

